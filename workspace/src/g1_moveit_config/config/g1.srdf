<?xml version="1.0"?>
<robot name="g1_29dof_with_hand_rev_1_0">
  <!-- Hand-written against g1_description's g1_lowcmd.urdf.xacro, except the generated
       disable_collisions block at the bottom. XML comments cannot contain a double hyphen: one
       makes move_group fail at launch.

       No virtual joint: the vendored URDF's floating base is commented out, so MoveIt plans in
       `pelvis`. Scene objects fixed in `odom`, or reaching while walking, need a floating
       virtual joint to `odom`. -->

  <!-- Rooted at torso_link: the waist joints belong to waist_freeze_controller and the balance
       policy, so a group spanning them would plan motion nothing executes. Tipped at the Dex5 base
       link, which sits on the wrist through a fixed mount and keeps the finger joints out of the
       group. -->
  <group name="left_arm">
    <chain base_link="torso_link" tip_link="left_dex5_base_link"/>
  </group>
  <group name="right_arm">
    <chain base_link="torso_link" tip_link="right_dex5_base_link"/>
  </group>

  <!-- Both arms as one 14-joint group: the only group that collision-checks one arm against the
       other and times a motion so both hands arrive together.

       No kinematics.yaml entry, on purpose. Chain solvers reject this two-branch group, and
       MoveIt builds the per-arm subgroup solver map only for a group without a solver of its
       own. -->
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <!-- Each Dex5 hand: its six active joints, in the order G1Dex5SystemLeft or G1Dex5SystemRight
       claims them. The mimic joints follow these through the URDF and are not listed. Never part
       of an arm group: each hand is a separate component with its own controller. -->
  <group name="left_hand">
    <joint name="left_thumb_1_joint"/>
    <joint name="left_thumb_2_joint"/>
    <joint name="left_index_1_joint"/>
    <joint name="left_middle_1_joint"/>
    <joint name="left_ring_1_joint"/>
    <joint name="left_little_1_joint"/>
  </group>

  <group name="right_hand">
    <joint name="right_thumb_1_joint"/>
    <joint name="right_thumb_2_joint"/>
    <joint name="right_index_1_joint"/>
    <joint name="right_middle_1_joint"/>
    <joint name="right_ring_1_joint"/>
    <joint name="right_little_1_joint"/>
  </group>

  <!-- Lets attachObject derive its touch links and RViz offer each hand as its arm's gripper. -->
  <end_effector name="left_gripper" parent_link="left_dex5_base_link"
                group="left_hand" parent_group="left_arm"/>
  <end_effector name="right_gripper" parent_link="right_dex5_base_link"
                group="right_hand" parent_group="right_arm"/>

  <!-- No passive_joint for the legs and waist: CurrentStateMonitor still waits on every active
       joint, so the flag would imply an exemption it does not give. -->

  <!-- Arm postures, each declared for left_arm, right_arm and both_arms because a group state
       belongs to one group; test_robot_model asserts the copies agree. Shoulder roll and yaw flip
       sign between the arms (positive left roll and negative right roll both swing outward);
       pitch and elbow do not.

       `home` is the arms' resting posture. Its small shoulder roll keeps the palm off the
       thigh. -->

  <group_state name="home" group="left_arm">
    <joint name="left_shoulder_pitch_joint" value="-0.70"/>
    <joint name="left_shoulder_roll_joint" value="0.15"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="1.50"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="home" group="right_arm">
    <joint name="right_shoulder_pitch_joint" value="-0.70"/>
    <joint name="right_shoulder_roll_joint" value="-0.15"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="1.50"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="home" group="both_arms">
    <joint name="left_shoulder_pitch_joint" value="-0.70"/>
    <joint name="left_shoulder_roll_joint" value="0.15"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="1.50"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
    <joint name="right_shoulder_pitch_joint" value="-0.70"/>
    <joint name="right_shoulder_roll_joint" value="-0.15"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="1.50"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>

  <group_state name="zero" group="left_arm">
    <joint name="left_shoulder_pitch_joint" value="0.00"/>
    <joint name="left_shoulder_roll_joint" value="0.00"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="0.00"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="zero" group="right_arm">
    <joint name="right_shoulder_pitch_joint" value="0.00"/>
    <joint name="right_shoulder_roll_joint" value="0.00"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="0.00"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="zero" group="both_arms">
    <joint name="left_shoulder_pitch_joint" value="0.00"/>
    <joint name="left_shoulder_roll_joint" value="0.00"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="0.00"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
    <joint name="right_shoulder_pitch_joint" value="0.00"/>
    <joint name="right_shoulder_roll_joint" value="0.00"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="0.00"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>

  <!-- Shoulder roll 0.55 swings the thumb clear of the hip, by the 0.20 rad test_robot_model
       requires. -->
  <group_state name="tucked" group="left_arm">
    <joint name="left_shoulder_pitch_joint" value="0.25"/>
    <joint name="left_shoulder_roll_joint" value="0.55"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="1.30"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="tucked" group="right_arm">
    <joint name="right_shoulder_pitch_joint" value="0.25"/>
    <joint name="right_shoulder_roll_joint" value="-0.55"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="1.30"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="tucked" group="both_arms">
    <joint name="left_shoulder_pitch_joint" value="0.25"/>
    <joint name="left_shoulder_roll_joint" value="0.55"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="1.30"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
    <joint name="right_shoulder_pitch_joint" value="0.25"/>
    <joint name="right_shoulder_roll_joint" value="-0.55"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="1.30"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>

  <group_state name="ready" group="left_arm">
    <joint name="left_shoulder_pitch_joint" value="-0.35"/>
    <joint name="left_shoulder_roll_joint" value="0.25"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="1.00"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="ready" group="right_arm">
    <joint name="right_shoulder_pitch_joint" value="-0.35"/>
    <joint name="right_shoulder_roll_joint" value="-0.25"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="1.00"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="ready" group="both_arms">
    <joint name="left_shoulder_pitch_joint" value="-0.35"/>
    <joint name="left_shoulder_roll_joint" value="0.25"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="1.00"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
    <joint name="right_shoulder_pitch_joint" value="-0.35"/>
    <joint name="right_shoulder_roll_joint" value="-0.25"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="1.00"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>

  <group_state name="reach_front" group="left_arm">
    <joint name="left_shoulder_pitch_joint" value="-0.90"/>
    <joint name="left_shoulder_roll_joint" value="0.20"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="0.70"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="reach_front" group="right_arm">
    <joint name="right_shoulder_pitch_joint" value="-0.90"/>
    <joint name="right_shoulder_roll_joint" value="-0.20"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="0.70"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="reach_front" group="both_arms">
    <joint name="left_shoulder_pitch_joint" value="-0.90"/>
    <joint name="left_shoulder_roll_joint" value="0.20"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="0.70"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
    <joint name="right_shoulder_pitch_joint" value="-0.90"/>
    <joint name="right_shoulder_roll_joint" value="-0.20"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="0.70"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>

  <!-- `carry` holds a picked object low beside the body: arm nearly straight, angled down and
       forward, wrist flat. Shoulder roll 0.45 keeps the thumb off the hip. -->
  <group_state name="carry" group="left_arm">
    <joint name="left_shoulder_pitch_joint" value="-0.55"/>
    <joint name="left_shoulder_roll_joint" value="0.45"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="1.80"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="carry" group="right_arm">
    <joint name="right_shoulder_pitch_joint" value="-0.55"/>
    <joint name="right_shoulder_roll_joint" value="-0.45"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="1.80"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>
  <group_state name="carry" group="both_arms">
    <joint name="left_shoulder_pitch_joint" value="-0.55"/>
    <joint name="left_shoulder_roll_joint" value="0.45"/>
    <joint name="left_shoulder_yaw_joint" value="0.00"/>
    <joint name="left_elbow_joint" value="1.80"/>
    <joint name="left_wrist_roll_joint" value="0.00"/>
    <joint name="left_wrist_pitch_joint" value="0.00"/>
    <joint name="left_wrist_yaw_joint" value="0.00"/>
    <joint name="right_shoulder_pitch_joint" value="-0.55"/>
    <joint name="right_shoulder_roll_joint" value="-0.45"/>
    <joint name="right_shoulder_yaw_joint" value="0.00"/>
    <joint name="right_elbow_joint" value="1.80"/>
    <joint name="right_wrist_roll_joint" value="0.00"/>
    <joint name="right_wrist_pitch_joint" value="0.00"/>
    <joint name="right_wrist_yaw_joint" value="0.00"/>
  </group_state>

  <!-- Dex5 postures for each hand, identical per side: open, pinch_ready and closed, each naming all six active joints.
       PROVISIONAL: chosen from the URDF ranges (0 to 1.658, 0 to 0.62 and 0 to 1.4381 rad) and
       not checked against a grasp, because the mounts are zero placeholders and the meshes are not
       committed. `open` is the URDF zero, fingers straight. `pinch_ready` brings the thumb partway
       in with the fingers open; `closed` curls every finger to about 80 percent of its range with
       the thumb opposed. -->
  <group_state name="open" group="left_hand">
    <joint name="left_thumb_1_joint" value="0.00"/>
    <joint name="left_thumb_2_joint" value="0.00"/>
    <joint name="left_index_1_joint" value="0.00"/>
    <joint name="left_middle_1_joint" value="0.00"/>
    <joint name="left_ring_1_joint" value="0.00"/>
    <joint name="left_little_1_joint" value="0.00"/>
  </group_state>
  <group_state name="pinch_ready" group="left_hand">
    <joint name="left_thumb_1_joint" value="0.80"/>
    <joint name="left_thumb_2_joint" value="0.00"/>
    <joint name="left_index_1_joint" value="0.00"/>
    <joint name="left_middle_1_joint" value="0.00"/>
    <joint name="left_ring_1_joint" value="0.00"/>
    <joint name="left_little_1_joint" value="0.00"/>
  </group_state>
  <group_state name="closed" group="left_hand">
    <joint name="left_thumb_1_joint" value="1.30"/>
    <joint name="left_thumb_2_joint" value="0.50"/>
    <joint name="left_index_1_joint" value="1.15"/>
    <joint name="left_middle_1_joint" value="1.15"/>
    <joint name="left_ring_1_joint" value="1.15"/>
    <joint name="left_little_1_joint" value="1.15"/>
  </group_state>
  <group_state name="open" group="right_hand">
    <joint name="right_thumb_1_joint" value="0.00"/>
    <joint name="right_thumb_2_joint" value="0.00"/>
    <joint name="right_index_1_joint" value="0.00"/>
    <joint name="right_middle_1_joint" value="0.00"/>
    <joint name="right_ring_1_joint" value="0.00"/>
    <joint name="right_little_1_joint" value="0.00"/>
  </group_state>
  <group_state name="pinch_ready" group="right_hand">
    <joint name="right_thumb_1_joint" value="0.80"/>
    <joint name="right_thumb_2_joint" value="0.00"/>
    <joint name="right_index_1_joint" value="0.00"/>
    <joint name="right_middle_1_joint" value="0.00"/>
    <joint name="right_ring_1_joint" value="0.00"/>
    <joint name="right_little_1_joint" value="0.00"/>
  </group_state>
  <group_state name="closed" group="right_hand">
    <joint name="right_thumb_1_joint" value="1.30"/>
    <joint name="right_thumb_2_joint" value="0.50"/>
    <joint name="right_index_1_joint" value="1.15"/>
    <joint name="right_middle_1_joint" value="1.15"/>
    <joint name="right_ring_1_joint" value="1.15"/>
    <joint name="right_little_1_joint" value="1.15"/>
  </group_state>

  <!-- Generated: links joined by a joint (Adjacent) and links touching at rest per
       /check_state_validity (Default). Without them the start state is in collision and
       RRTConnect refuses to seed. No sampled "never in collision" pairs: collisions_updater does
       not finish on the URDF's full-mesh collision geometry. No cross-arm pair either, since
       both_arms exists to check one arm against the other. -->
  <disable_collisions link1="d435_link" link2="camera_color_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="d435_link" link2="camera_depth_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="head_link" link2="torso_link" reason="Default"/>
  <disable_collisions link1="left_ankle_pitch_link" link2="left_ankle_roll_link" reason="Adjacent"/>
  <disable_collisions link1="left_ankle_pitch_link" link2="left_knee_link" reason="Default"/>
  <disable_collisions link1="left_elbow_link" link2="left_shoulder_yaw_link" reason="Default"/>
  <disable_collisions link1="left_elbow_link" link2="left_wrist_roll_link" reason="Adjacent"/>
  <disable_collisions link1="left_hip_pitch_link" link2="left_hip_roll_link" reason="Adjacent"/>
  <disable_collisions link1="left_hip_roll_link" link2="left_hip_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="left_hip_yaw_link" link2="left_knee_link" reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_pitch_link" link2="left_shoulder_roll_link" reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_roll_link" link2="left_shoulder_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="left_wrist_pitch_link" link2="left_wrist_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="left_wrist_roll_link" link2="left_wrist_pitch_link" reason="Adjacent"/>
  <!-- Dex5 links joined by a joint, derived from the URDF. Only these Adjacent pairs: no resting
       "Default" pairs and no thumb-to-wrist exemption are known yet, since the meshes are not
       committed and nothing has been checked with /check_state_validity. -->
  <disable_collisions link1="left_dex5_base_link" link2="left_index_1" reason="Adjacent"/>
  <disable_collisions link1="left_dex5_base_link" link2="left_little_1" reason="Adjacent"/>
  <disable_collisions link1="left_dex5_base_link" link2="left_middle_1" reason="Adjacent"/>
  <disable_collisions link1="left_dex5_base_link" link2="left_plam_1" reason="Adjacent"/>
  <disable_collisions link1="left_dex5_base_link" link2="left_ring_1" reason="Adjacent"/>
  <disable_collisions link1="left_dex5_base_link" link2="left_thumb_1" reason="Adjacent"/>
  <disable_collisions link1="left_index_1" link2="left_index_2" reason="Adjacent"/>
  <disable_collisions link1="left_index_1" link2="left_index_force_sensor_1" reason="Adjacent"/>
  <disable_collisions link1="left_index_2" link2="left_index_force_sensor_2" reason="Adjacent"/>
  <disable_collisions link1="left_index_2" link2="left_index_force_sensor_3" reason="Adjacent"/>
  <disable_collisions link1="left_little_1" link2="left_little_2" reason="Adjacent"/>
  <disable_collisions link1="left_little_1" link2="left_little_force_sensor_1" reason="Adjacent"/>
  <disable_collisions link1="left_little_2" link2="left_little_force_sensor_2" reason="Adjacent"/>
  <disable_collisions link1="left_little_2" link2="left_little_force_sensor_3" reason="Adjacent"/>
  <disable_collisions link1="left_middle_1" link2="left_middle_2" reason="Adjacent"/>
  <disable_collisions link1="left_middle_1" link2="left_middle_force_sensor_1" reason="Adjacent"/>
  <disable_collisions link1="left_middle_2" link2="left_middle_force_sensor_2" reason="Adjacent"/>
  <disable_collisions link1="left_middle_2" link2="left_middle_force_sensor_3" reason="Adjacent"/>
  <disable_collisions link1="left_plam_1" link2="left_plam_2" reason="Adjacent"/>
  <disable_collisions link1="left_plam_1" link2="left_plam_force_sensor" reason="Adjacent"/>
  <disable_collisions link1="left_ring_1" link2="left_ring_2" reason="Adjacent"/>
  <disable_collisions link1="left_ring_1" link2="left_ring_force_sensor_1" reason="Adjacent"/>
  <disable_collisions link1="left_ring_2" link2="left_ring_force_sensor_2" reason="Adjacent"/>
  <disable_collisions link1="left_ring_2" link2="left_ring_force_sensor_3" reason="Adjacent"/>
  <disable_collisions link1="left_thumb_1" link2="left_thumb_2" reason="Adjacent"/>
  <disable_collisions link1="left_thumb_2" link2="left_thumb_3" reason="Adjacent"/>
  <disable_collisions link1="left_thumb_2" link2="left_thumb_force_sensor_1" reason="Adjacent"/>
  <disable_collisions link1="left_thumb_3" link2="left_thumb_4" reason="Adjacent"/>
  <disable_collisions link1="left_thumb_3" link2="left_thumb_force_sensor_2" reason="Adjacent"/>
  <disable_collisions link1="left_thumb_4" link2="left_thumb_force_sensor_3" reason="Adjacent"/>
  <disable_collisions link1="left_thumb_4" link2="left_thumb_force_sensor_4" reason="Adjacent"/>
  <disable_collisions link1="left_dex5_base_link" link2="left_wrist_yaw_link" reason="Adjacent"/>
