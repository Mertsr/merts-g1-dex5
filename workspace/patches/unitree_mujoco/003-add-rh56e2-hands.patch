-    
+    <!-- RH56E2 fingers. No <actuator> and no <sensor> entries on purpose: the SDK bridge
+         sizes itself from nu and indexes a fixed 35-slot LowCmd, so 29 + 12 would run it
+         off the end of the array. The hand is a separate device on its own topics and is
+         driven through qfrc_applied instead. armature deliberately dominates the physical
+         finger inertia (~1e-5 kg m^2), which keeps the hand's PD overdamped at the 2 ms
+         timestep so its gains drive the sim unchanged rather than being retuned for it. -->
+    <default class="rh56e2_motor">
+      <joint damping="0.01" armature="0.001" frictionloss="0.01"/>
+    </default>
+    <!-- What you see: no contact, no mass (the bodies carry explicit inertials). -->
+    <default class="rh56e2_visual">
+      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"
+        rgba="0.7 0.7 0.7 1"/>
+    </default>
+    <!-- What collides: the same meshes as convex hulls, hidden in group 3. Bitmask
+         contype=2 / conaffinity=1 against everything else's 1 / 1: a hand geom contacts the
+         world, scene objects and the rest of the robot, but never another hand geom --
+         adjacent finger hulls overlap at their joints and would otherwise be in permanent
+         contact. condim 4 adds torsional friction so a pinched object does not spin out;
+         sliding friction 1.5 is a GUESS for rubber finger pads, not a measurement. -->
+    <default class="rh56e2_collision">
+      <geom type="mesh" contype="2" conaffinity="1" condim="4" group="3" density="0"
+        friction="1.5 0.02 0.001" rgba="0.9 0.4 0.3 0.5"/>
+    </default>
   </default>
 
